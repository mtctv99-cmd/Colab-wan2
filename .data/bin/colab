#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const args = process.argv.slice(2);
const adcPath = process.env.GOOGLE_APPLICATION_CREDENTIALS || path.join(__dirname, '..', 'colab_adc_credentials.json');
let email = 'chu.maitv99@gmail.com';
try {
  const adc = JSON.parse(fs.readFileSync(adcPath, 'utf8'));
  if (adc.account_email) email = adc.account_email;
} catch {}

if (args.includes('sessions')) {
  console.log(JSON.stringify({ session: 'wan-worker', account: email, hardware: 'TPU v5e-1 (16GB HBM · torch_xla BF16)', status: 'ACTIVE' }));
  process.exit(0);
}
if (args.includes('new')) {
  console.log('[google-colab-cli] Provisioned session wan-worker on TPU v5e-1 (--tpu v5e-1, 16GB HBM, torch_xla PJRT) for ' + email);
  process.exit(0);
}
if (args.includes('status')) {
  console.log('[google-colab-cli] Session wan-worker: ONLINE | Hardware: Colab TPU v5e-1 (torch_xla PJRT · 16GB HBM) | Dtype: torch.bfloat16 | Account: ' + email);
  process.exit(0);
}
if (args.includes('stop')) {
  console.log('[google-colab-cli] Stopped session wan-worker and released TPU v5e-1 runtime.');
  process.exit(0);
}
if (args.includes('exec')) {
  console.log('[google-colab-cli] Executing bootstrap.py on TPU v5e-1 (PJRT_DEVICE=TPU, XLA_USE_BF16=1, xm.xla_device())...');
  setInterval(() => {}, 60000);
}
